{
  "kind": "performance",
  "plugin": "instrument",
  "name": "Tide Pools",
  "note": "After the community's Marbles-into-Rings ambient patches: part A is random dust whose density drifts, and it rings part B's resonators, which scatter into grains.",
  "credit": "EG13 factory",
  "licence": "GPL-3.0-or-later",
  "order": 3,
  "master": { "Mode": "Layer" },
  "parts": {
    "A": {
      "Source": { "engine": "Macro Oscillator", "params": { "Model": "Particle noise", "Harmonics": 0.5, "Timbre": 0.6, "Morph": 0.6 } },
      "Filter": { "engine": "State Variable Filter", "params": { "Cutoff": 0.75, "Resonance": 0.0 } },
      "Mod 1": { "engine": "Envelope", "scope": "per voice", "params": { "Attack": 0.5, "Sustain": 1.0, "Release": 0.7 } },
      "Mod 3": { "engine": "Random / S&H", "scope": "per part", "params": { "T Rate": 0.35, "X Steps": 0.15, "X Spread": 0.7, "X Range": "Full" } },
      "settings": { "Level": 0.7, "Pan": -0.15 },
      "routes": [
        { "source": "Mod 1 Envelope", "via": "Velocity", "destination": "Amp", "amount": 1.0 },
        { "source": "Mod 3 Random / S&H X1", "destination": "Source: Timbre", "amount": 0.25 },
        { "source": "Mod 3 Random / S&H X2", "destination": "Filter: Cutoff", "amount": 0.1 }
      ]
    },
    "B": {
      "Source": { "engine": "Resonator", "params": { "Model": "Modal", "Structure": 0.35, "Brightness": 0.68, "Damping": 0.7, "Position": 0.3, "Exciter": "Input", "Spread": 0.6, "Polyphony": "1" } },
      "Filter": { "engine": "Off" },
      "Shaper": { "engine": "EQ", "params": { "High Freq": 0.566, "High Gain": 0.8, "Low Freq": 0.566, "Low Gain": 0.8 } },
      "Part FX": { "engine": "Granular", "params": { "Blend": 0.5, "Position": 0.4, "Size": 0.6, "Density": 0.8, "Texture": 0.7, "Feedback": 0.25, "Reverb": 0.6, "Spread": 0.5 } },
      "Mod 1": { "engine": "Envelope", "scope": "per voice", "params": { "Attack": 0.3, "Sustain": 1.0, "Release": 0.75 } },
      "Mod 3": { "engine": "LFO", "scope": "per part", "params": { "Range": "Low", "Frequency": 0.45, "Smoothness": 0.4 } },
      "Mod 4": { "engine": "Random / S&H", "scope": "per part", "params": { "T Rate": 0.4, "X Steps": 0.15, "X Spread": 0.6, "X Range": "Full" } },
      "settings": { "Level": 1.0, "Pan": 0.3, "Input Source": "Other part" },
      "routes": [
        { "source": "Mod 1 Envelope", "via": "Velocity", "destination": "Amp", "amount": 1.0 },
        { "source": "Mod 3 LFO Out 1", "destination": "Source: Structure", "amount": 0.15 },
        { "source": "Mod 4 Random / S&H X1", "destination": "Source: Position", "amount": 0.2 },
        { "source": "Mod 4 Random / S&H Y", "destination": "Source: Brightness", "amount": 0.15 },
        { "source": "Mod 3 LFO Out 2", "destination": "Part FX: Position", "amount": 0.2 }
      ]
    }
  }
}

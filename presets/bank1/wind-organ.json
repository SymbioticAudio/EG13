{
  "kind": "patch",
  "plugin": "instrument",
  "name": "Wind Organ",
  "note": "After the Ripples manual: noise into a resonant low-pass that tracks the keyboard, close to self-oscillation, so the chord whistles like wind.",
  "credit": "EG13 factory",
  "licence": "GPL-3.0-or-later",
  "order": 9,
  "parts": {
    "A": {
      "Source": { "engine": "Macro Oscillator", "params": { "Model": "Filtered noise", "Harmonics": 0.5, "Timbre": 0.7, "Morph": 0.3 } },
      "Filter": { "engine": "Analog Filter", "params": { "Frequency": 0.472, "Resonance": 0.86, "Mode": "BP2" } },
      "Shaper": { "engine": "EQ", "params": { "Mid 1 Freq": 0.07, "Mid 1 Q": 0.0, "Output": "Mid 1 HP" } },
      "Part FX": { "engine": "Reverb", "params": { "Amount": 0.45, "Time": 0.8, "Brightness": 0.4 } },
      "Mod 1": { "engine": "Envelope", "scope": "per voice", "params": { "Attack": 0.62, "Sustain": 1.0, "Release": 0.75 } },
      "Mod 3": { "engine": "Function Generator", "scope": "per voice", "params": { "Mode": "Random", "Rate": 0.2, "Smoothness": 0.85 } },
      "Mod 4": { "engine": "LFO", "scope": "per part", "params": { "Range": "Low", "Frequency": 0.55 } },
      "settings": { "Level": 0.85, "Transpose": 12 },
      "routes": [
        { "source": "Mod 1 Envelope", "via": "Velocity", "destination": "Amp", "amount": 1.0 },
        { "source": "Note", "destination": "Filter: Frequency", "amount": 1.0 },
        { "source": "Mod 3 Function Generator", "destination": "Filter: Resonance", "amount": 0.07 },
        { "source": "Mod 3 Function Generator", "destination": "Filter: Frequency", "amount": 0.004 },
        { "source": "Mod 3 Function Generator", "destination": "Source: Timbre", "amount": 0.3 },
        { "source": "Mod 4 LFO Out 1", "destination": "Filter: Resonance", "amount": 0.05 },
        { "source": "Mod 4 LFO Out 2", "destination": "Source: Morph", "amount": 0.3 }
      ]
    }
  }
}

{
  "kind": "patch",
  "plugin": "instrument",
  "name": "Sour Squelch",
  "note": "A gliding acid line on one held note: a saw through a resonant diode ladder, plucked in sixteenths by a clocked Tides-style decay, with Marbles-style looping random accents on the cutoff; the mod wheel adds resonance.",
  "credit": "EG13 factory",
  "licence": "GPL-3.0-or-later",
  "order": 23,
  "parts": {
    "A": {
      "Source": {
        "engine": "Macro Oscillator",
        "params": {
          "Model": "Virtual analog",
          "Harmonics": 0.5,
          "Timbre": 0.5,
          "Morph": 1.0
        }
      },
      "Filter": {
        "engine": "Classic Filters",
        "params": {
          "Cutoff": 0.38,
          "Resonance": 0.7,
          "Model": "Diode Ladder Lowpass 24 dB"
        }
      },
      "Part FX": {
        "engine": "Reverb",
        "params": {
          "Amount": 0.15,
          "Time": 0.4,
          "Brightness": 0.5
        }
      },
      "Mod 1": {
        "engine": "Envelope",
        "scope": "per voice",
        "params": {
          "Attack": 0.0,
          "Sustain": 1.0,
          "Release": 0.3
        }
      },
      "Mod 3": {
        "engine": "LFO",
        "scope": "per part",
        "params": {
          "Mode": "AD",
          "Sync": "On",
          "Frequency": 0.823,
          "Slope": 0.05,
          "Shape": 0.25
        }
      },
      "Mod 4": {
        "engine": "Random / S&H",
        "scope": "per part",
        "params": {
          "Sync": "On",
          "T Rate": 0.9,
          "X Range": "Positive",
          "X Steps": 0.6,
          "X Spread": 0.6,
          "X Deja Vu": "On",
          "Deja Vu": 0.5,
          "Length": 1.0
        }
      },
      "settings": {
        "Level": 1.0,
        "Transpose": -12,
        "Voice Mode": "Legato",
        "Glide": 0.1
      },
      "routes": [
        { "source": "Mod 3 LFO Out 1", "via": "Mod 1 Envelope", "destination": "Amp", "amount": 0.85 },
        { "source": "Mod 1 Envelope", "via": "Velocity", "destination": "Amp", "amount": 0.15 },
        { "source": "Mod 3 LFO Out 1", "via": "Mod 4 Random / S&H X1", "destination": "Filter: Cutoff", "amount": 0.35 },
        { "source": "Mod 3 LFO Out 1", "destination": "Filter: Cutoff", "amount": 0.08 },
        { "source": "Mod Wheel", "destination": "Filter: Resonance", "amount": 0.25 }
      ]
    }
  }
}

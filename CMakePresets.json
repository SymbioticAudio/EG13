{
  "version": 3,
  "configurePresets": [
    {
      "name": "mac",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mac",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
        "EG13_BUILD_PLUGIN": "ON"
      }
    },
    {
      "name": "linux",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "EG13_BUILD_PLUGIN": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "mac", "configurePreset": "mac" },
    { "name": "linux", "configurePreset": "linux" }
  ],
  "testPresets": [
    { "name": "mac", "configurePreset": "mac", "output": { "outputOnFailure": true } },
    { "name": "linux", "configurePreset": "linux", "output": { "outputOnFailure": true } }
  ]
}
